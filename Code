  const fs=FEATS.filter(f=>on[f.k]);for(const p of state.data)p.f=fs.map(f=>f.f(p.x,p.y));
  const net=new Net([fs.length,...h,1],a);for(let e=0;e<90;e++){epochOn(net,state.train,.05,16);if(e%30===29)await new Promise(r=>setTimeout(r))}
