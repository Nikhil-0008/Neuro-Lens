 const pos=sizes.map((n,l)=>{const st=n>1?Math.min(40,(H-40)/(n-1)):0;return Array.from({length:n},(_,i)=>({x:padX+(W-2*padX)*l/(L-1),y:H/2+(i-(n-1)/2)*st}))});
 for(let l=0;l<L-1;l++)for(let j=0;j<sizes[l+1];j++)for(let i=0;i<sizes[l];i++){const w=net.W[l][j][i],a=Math.min(.9,.12+Math.abs(w)*.3);
  ctx.strokeStyle=w>0?`rgba(255,200,87,${a})`:`rgba(110,168,255,${a})`;ctx.lineWidth=Math.min(3.4,.4+Math.abs(w)*.9);
  ctx.beginPath();ctx.moveTo(pos[l][i].x,pos[l][i].y);ctx.lineTo(pos[l+1][j].x,pos[l+1][j].y);ctx.stroke()}
 for(let l=0;l<L;l++)for(let i=0;i<sizes[l];i++){const{x,y}=pos[l][i];ctx.beginPath();ctx.arc(x,y,10,0,7);ctx.fillStyle='#0a1324';ctx.fill();ctx.lineWidth=2;ctx.strokeStyle=l===L-1?'#ff5ca8':'#8da2c4';ctx.stroke()}
 ctx.fillStyle='#8da2c4';ctx.font='15px system-ui,sans-serif';ctx.textAlign='right';ctx.textBaseline='middle';
 active().forEach((f,i)=>ctx.fillText(f.label,pos[0][i].x-18,pos[0][i].y));ctx.textAlign='left';ctx.fillText('A or B',pos[L-1][0].x+18,pos[L-1][0].y)}
function drawLoss(){const c=$('#lossview'),ctx=c.getContext('2d'),W=c.width,H=c.height,h=state.hist;ctx.clearRect(0,0,W,H);
