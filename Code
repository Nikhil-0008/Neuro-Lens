 for(const p of state.train){const[px,py]=toPx(p.x,p.y);bctx.beginPath();bctx.arc(px,py,6,0,7);bctx.fillStyle=col(p.l);bctx.fill();bctx.lineWidth=1.5;bctx.strokeStyle='#08111f';bctx.stroke()}
