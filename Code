async function autoTune(){if(state.busy)return;state.busy=true;const btn=$('#auto');btn.disabled=true;
 const sets=[{x:1,y:1},{x:1,y:1,x2:1,y2:1,xy:1},{x:1,y:1,sinx:1,siny:1}],
  shapes=[[4],[8],[6,4],[8,6],[8,8,4]],acts=['tanh','relu'],jobs=[];
