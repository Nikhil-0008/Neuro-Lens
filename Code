<script>
"use strict";
const $=s=>document.querySelector(s), R=1.2, BG=[8,17,31], PINK=[255,92,168], TEAL=[47,224,192];
const FEATS=[{k:'x',label:'x',f:(x,y)=>x},{k:'y',label:'y',f:(x,y)=>y},{k:'x2',label:'x\u00b2',f:(x,y)=>x*x},
 {k:'y2',label:'y\u00b2',f:(x,y)=>y*y},{k:'xy',label:'xy',f:(x,y)=>x*y},{k:'sinx',label:'sin 3x',f:(x,y)=>Math.sin(3*x)},{k:'siny',label:'sin 3y',f:(x,y)=>Math.sin(3*y)}];
const state={dataset:'spiral',noise:.08,n:300,seed:Math.floor(Math.random()*1e6),hidden:[6,4],act:'tanh',lr:.03,batch:16,speed:2,
 on:{x:true,y:true,x2:false,y2:false,xy:false,sinx:false,siny:false},data:[],train:[],test:[],net:null,running:true,dirty:true,epoch:0,hist:[],
 m:{trL:0,trA:0,teL:0,teA:0},frames:0,csv:null,busy:false};
const active=()=>FEATS.filter(f=>state.on[f.k]);
const featVec=(x,y)=>active().map(f=>f.f(x,y));

/* ---- neural network from scratch ---- */
function randn(){let u=0,v=0;while(!u)u=Math.random();while(!v)v=Math.random();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v)}
const ACT={tanh:{f:Math.tanh,d:y=>1-y*y},relu:{f:x=>x>0?x:.01*x,d:y=>y>0?1:.01},sigmoid:{f:x=>1/(1+Math.exp(-x)),d:y=>y*(1-y)}};
class Net{
 constructor(sizes,act){this.sizes=sizes;this.a=ACT[act];this.W=[];this.b=[];
  for(let l=1;l<sizes.length;l++){const m=sizes[l-1],n=sizes[l],s=Math.sqrt(2/(m+n));
   this.W.push(Array.from({length:n},()=>Array.from({length:m},()=>randn()*s)));this.b.push(new Array(n).fill(0))}}
 forward(x){const acts=[x];let cur=x;
  for(let l=0;l<this.W.length;l++){const last=l===this.W.length-1,out=new Array(this.W[l].length);
   for(let j=0;j<out.length;j++){let s=this.b[l][j];const w=this.W[l][j];for(let i=0;i<cur.length;i++)s+=w[i]*cur[i];
    out[j]=last?1/(1+Math.exp(-s)):this.a.f(s)}acts.push(out);cur=out}return acts}
 predict(x){const a=this.forward(x);return a[a.length-1][0]}
 trainBatch(batch,lr){const L=this.W.length,gW=this.W.map(M=>M.map(r=>r.map(()=>0))),gb=this.b.map(v=>v.map(()=>0));
  for(const p of batch){const a=this.forward(p.f);let delta=[a[L][0]-p.l];
   for(let l=L-1;l>=0;l--){const prev=a[l];
    for(let j=0;j<delta.length;j++){gb[l][j]+=delta[j];for(let i=0;i<prev.length;i++)gW[l][j][i]+=delta[j]*prev[i]}
    if(l>0){const nd=new Array(prev.length).fill(0);
     for(let i=0;i<prev.length;i++){let s=0;for(let j=0;j<delta.length;j++)s+=this.W[l][j][i]*delta[j];nd[i]=s*this.a.d(prev[i])}delta=nd}}}
  const k=lr/batch.length;
  for(let l=0;l<L;l++)for(let j=0;j<this.W[l].length;j++){this.b[l][j]-=k*gb[l][j];for(let i=0;i<this.W[l][j].length;i++)this.W[l][j][i]-=k*gW[l][j][i]}}
}
function epochOn(net,t,lr,bs){const idx=t.map((_,i)=>i);
 for(let i=idx.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[idx[i],idx[j]]=[idx[j],idx[i]]}
 for(let s=0;s<idx.length;s+=bs)net.trainBatch(idx.slice(s,s+bs).map(i=>t[i]),lr)}
function scoreOn(net,set){if(!set.length)return{loss:0,acc:0};let L=0,c=0;const e=1e-7;
 for(const p of set){const q=net.predict(p.f);L-=p.l?Math.log(q+e):Math.log(1-q+e);if((q>.5)===(p.l===1))c++}
 return{loss:L/set.length,acc:c/set.length}}
function trainEpoch(){epochOn(state.net,state.train,state.lr,state.batch);state.epoch++}
function evaluate(rec){const a=scoreOn(state.net,state.train),b=scoreOn(state.net,state.test);
 state.m={trL:a.loss,trA:a.acc,teL:b.loss,teA:b.acc};
 if(rec){state.hist.push({tr:a.loss,te:b.loss});if(state.hist.length>300)state.hist.shift()}}
function prep(){for(const p of state.data)p.f=featVec(p.x,p.y)}
function rebuild(){prep();state.net=new Net([active().length,...state.hidden,1],state.act);state.epoch=0;state.hist=[];evaluate(false);state.dirty=true}

/* ---- drawing ---- */
const board=$('#board'),bctx=board.getContext('2d'),G=56,grid=document.createElement('canvas');grid.width=G;grid.height=G;
const gctx=grid.getContext('2d'),gimg=gctx.createImageData(G,G),toPx=(x,y)=>[(x+R)/(2*R)*board.width,(1-(y+R)/(2*R))*board.height];
function drawBoard(){const W=board.width,H=board.height,d=gimg.data;
 for(let j=0;j<G;j++)for(let i=0;i<G;i++){const x=-R+(i+.5)/G*2*R,y=R-(j+.5)/G*2*R,p=state.net.predict(featVec(x,y)),c=p>.5?PINK:TEAL,m=.12+.55*Math.abs(p-.5)*2;
  let r=BG[0]+(c[0]-BG[0])*m,g=BG[1]+(c[1]-BG[1])*m,b=BG[2]+(c[2]-BG[2])*m;
  if(Math.abs(p-.5)<.04){r+=(255-r)*.5;g+=(255-g)*.5;b+=(255-b)*.5}
  const k=(j*G+i)*4;d[k]=r;d[k+1]=g;d[k+2]=b;d[k+3]=255}
