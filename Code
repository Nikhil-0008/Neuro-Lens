import json, math, random, threading, time
from pathlib import Path
from flask import Flask, jsonify, request

app = Flask(__name__)
DATASETS = ("circle", "xor", "spiral", "moons", "clusters")
BOARDS = DATASETS + ("custom",)
ACTS = ("tanh", "relu", "sigmoid")
FEATURE_KEYS = ("x", "y", "x2", "y2", "xy", "sinx", "siny")
EXP_FILE = Path(__file__).with_name("experiments.json")
_lock = threading.Lock()


def make_dataset(name, n, noise, seed):
    rng = random.Random(seed)
    jit, pts = noise * 0.6, []
    for i in range(n):
        label = i % 2
        if name == "circle":
            r = 0.5 * math.sqrt(rng.random()) if label else rng.uniform(0.75, 1.0)
            a = rng.uniform(0, 2 * math.pi)
            x, y = r * math.cos(a) + rng.gauss(0, jit), r * math.sin(a) + rng.gauss(0, jit)
        elif name == "xor":
            x, y = rng.uniform(-1, 1), rng.uniform(-1, 1)
            x += 0.12 if x >= 0 else -0.12
            y += 0.12 if y >= 0 else -0.12
            x = max(-1.1, min(1.1, x + rng.gauss(0, jit)))
            y = max(-1.1, min(1.1, y + rng.gauss(0, jit)))
            label = 1 if x * y > 0 else 0
        elif name == "spiral":
            t = (i // 2) / (n / 2)
            a = t * 3.2 * math.pi + label * math.pi
            x, y = t * 0.95 * math.cos(a) + rng.gauss(0, jit), t * 0.95 * math.sin(a) + rng.gauss(0, jit)
        elif name == "moons":
            a = rng.uniform(0, math.pi)
            x, y = (math.cos(a), math.sin(a)) if label == 0 else (1 - math.cos(a), 0.5 - math.sin(a))
            x, y = (x - 0.5) * 0.65 + rng.gauss(0, jit), (y - 0.25) * 0.65 + rng.gauss(0, jit)
        else:
            c = 0.45 if label else -0.45
            s = 0.22 + noise * 0.8
            x, y = rng.gauss(c, s), rng.gauss(c, s)
        pts.append([round(x, 4), round(y, 4), label])
    rng.shuffle(pts)
    return pts


def _num(v, lo, hi, default=None):
    try:
        f = float(v)
    except (TypeError, ValueError):
        return default
    return default if math.isnan(f) or f < lo or f > hi else f


def _load():
    try:
        d = json.loads(EXP_FILE.read_text(encoding="utf-8"))
        return d if isinstance(d, list) else []
    except (OSError, ValueError):
        return []


def _save(items):
    try:
        EXP_FILE.write_text(json.dumps(items[-500:]), encoding="utf-8")
    except OSError:
        pass


@app.get("/api/dataset")
def api_dataset():
    name = request.args.get("name", "spiral")
    if name not in DATASETS:
        return jsonify(error="Unknown dataset."), 400
    return jsonify(points=make_dataset(name, int(_num(request.args.get("n"), 60, 800, 300)),
                                       _num(request.args.get("noise"), 0, 0.5, 0.08),
                                       int(_num(request.args.get("seed"), 0, 10**9, 0))))


@app.post("/api/experiments")
def api_save():
    d = request.get_json(force=True, silent=True) or {}
    ds, act, hid, feats = d.get("dataset"), d.get("act"), d.get("hidden"), d.get("features")
    acc, loss = _num(d.get("test_acc"), 0, 1), _num(d.get("test_loss"), 0, 100)
    ep, lr = _num(d.get("epochs"), 0, 10**7), _num(d.get("lr"), 0, 10)
    ok = (ds in BOARDS and act in ACTS and isinstance(hid, list) and 1 <= len(hid) <= 4
          and all(isinstance(h, int) and 1 <= h <= 8 for h in hid)
          and isinstance(feats, list) and 1 <= len(feats) <= 7 and all(f in FEATURE_KEYS for f in feats)
          and None not in (acc, loss, ep, lr))
    if not ok:
        return jsonify(error="That run could not be saved: some values were invalid."), 400
    e = dict(dataset=ds, act=act, hidden=hid, features=feats, lr=lr, epochs=int(ep),
             test_acc=round(acc, 4), test_loss=round(loss, 4), ts=int(time.time()))
    with _lock:
        items = _load()
        items.append(e)
        _save(items)
    return jsonify(e), 201


@app.get("/api/experiments")
def api_list():
    ds = request.args.get("dataset")
    with _lock:
        items = _load()
    if ds in BOARDS:
        items = [e for e in items if e.get("dataset") == ds]
    items.sort(key=lambda e: (-e.get("test_acc", 0), e.get("epochs", 0)))
    return jsonify(runs=items[:6])


