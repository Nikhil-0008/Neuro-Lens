  const r=await fetch('/api/dataset?'+q);if(!r.ok)throw 0;split((await r.json()).points.map(([x,y,l])=>({x,y,l})))
 }catch(e){setStatus('Could not reach the server. Start codee.py and reload this page.')}}
function parseCSV(t){const lines=t.replace(/\r/g,'').split('\n').filter(l=>l.trim());
 if(lines.length<12)throw new Error('The file needs a header and at least 11 rows.');
 const sep=[',',';','\t'].map(s=>[s,lines[0].split(s).length]).sort((a,b)=>b[1]-a[1])[0][0];
 const rows=lines.map(l=>l.split(sep).map(c=>c.trim().replace(/^"|"$/g,'')));const num=v=>v!==''&&!isNaN(+v);
 const header=!rows[0].every(num),names=header?rows.shift():rows[0].map((_,i)=>'column '+(i+1));return{names,rows}}
function fillMap(){const{names,rows}=state.csv,nc=[],lc=[];
 names.forEach((n,i)=>{const col=rows.map(r=>r[i]);if(col.filter(v=>v!==''&&!isNaN(+v)).length>=.9*col.length)nc.push(i);
  const u=new Set(col).size;if(u>=2&&u<=12)lc.push(i)});
 if(nc.length<2||!lc.length)throw new Error('Could not find two numeric columns and a label column with 2 to 12 classes.');
 const opt=(ids,sel)=>ids.map(i=>`<option value="${i}" ${i===sel?'selected':''}>${names[i].replace(/</g,'&lt;')}</option>`).join('');
 const lab=[...lc].reverse().find(i=>!nc.slice(0,2).includes(i))??lc[lc.length-1];
 $('#cx').innerHTML=opt(nc,nc[0]);$('#cy').innerHTML=opt(nc,nc[1]);$('#cl').innerHTML=opt(lc,lab);fillClasses();$('#map').style.display='grid'}
function fillClasses(){const i=+$('#cl').value,u=[...new Set(state.csv.rows.map(r=>r[i]))];
 $('#cp').innerHTML=u.map(v=>`<option>${v.replace(/</g,'&lt;')}</option>`).join('')}
function applyCustom(){const{rows}=state.csv,xi=+$('#cx').value,yi=+$('#cy').value,li=+$('#cl').value,pos=$('#cp').value;
 let r=rows.filter(a=>!isNaN(+a[xi])&&a[xi]!==''&&!isNaN(+a[yi])&&a[yi]!=='');
 if(r.length<10)return setStatus('Fewer than 10 usable rows in those columns.');
 if(r.length>1500){r=r.sort(()=>Math.random()-.5).slice(0,1500);setStatus('Large file: using a random sample of 1,500 rows.')}
 const sc=i=>{const v=r.map(a=>+a[i]),lo=Math.min(...v),hi=Math.max(...v)||1;return x=>((x-lo)/((hi-lo)||1))*1.8-.9};
 const fx=sc(xi),fy=sc(yi),pts=r.map(a=>({x:fx(+a[xi]),y:fy(+a[yi]),l:a[li]===pos?1:0}));
 state.dataset='custom';document.querySelectorAll('#datasets button').forEach(b=>b.setAttribute('aria-pressed',false));
 $('#nameA').textContent=pos;$('#nameB').textContent='everything else';split(pts)}
